+      return;
+    }
+    setState(() => _busy = true);
+    try {
+      final folders = await widget.bridge.listFolders(account);
+      final folder = folders.contains(_folder) ? _folder : (folders.isEmpty ? 'INBOX' : folders.first);
+      final letters = await widget.bridge.fetchMessages(account, folder: folder);
+      if (!mounted) return;
