+class _Loopback {
+  _Loopback(this.imapPort, this.popPort, this.smtpPort, this._sockets, this.sent);
+
+  final int imapPort;
+  final int popPort;
+  final int smtpPort;
+  final List<ServerSocket> _sockets;
+  final List<String> sent;
+  static const _message = 'From: bob@example.com\r\n'
+      'To: ada@example.com\r\n'
+      'Subject: Hello rpMail\r\n'
+      'Message-ID: <m1@example.com>\r\n'
+      '\r\n'
+      'A private note.\r\n';
+
+  static Future<_Loopback> start({required String user, required String secret}) async {
+    final sent = <String>[];
+    final imap = await _listen((socket) => _imap(socket, user, secret));
+    final pop = await _listen((socket) => _pop(socket, user, secret));
+    final smtp = await _listen((socket) => _smtp(socket, user, secret, sent));
+    return _Loopback(imap.port, pop.port, smtp.port, [imap, pop, smtp], sent);
+  }
+
+  Future<void> close() async {
+    for (final socket in _sockets) {
+      await socket.close();
+    }
+  }
+
+  static Future<ServerSocket> _listen(void Function(Socket) onSocket) async {
+    final server = await ServerSocket.bind(InternetAddress.loopbackIPv4, 0);
+    server.listen(onSocket);
+    return server;
+  }
+
+  static Future<void> _imap(Socket socket, String user, String secret) async {
+    final reader = socket.cast<List<int>>().transform(utf8.decoder).transform(const LineSplitter());
+    void send(String line) => socket.write('$line\r\n');
+    send('* OK rpmail ready');
+    var authed = false;
+    await for (final line in reader) {
+      final parts = line.split(' ');
+      if (parts.length < 2) continue;
+      final tag = parts[0];
+      final cmd = parts[1].toUpperCase();
+      final rest = parts.length > 2 ? line.substring(tag.length + cmd.length + 2) : '';
+      if (cmd == 'CAPABILITY') {
+        send('* CAPABILITY IMAP4rev1');
+        send('$tag OK CAPABILITY completed');
+      } else if (cmd == 'LOGIN') {
+        authed = rest.contains(user) && rest.contains(secret);
+        send(authed ? '$tag OK LOGIN completed' : '$tag NO LOGIN failed');
+      } else if (cmd == 'LIST') {
+        send('* LIST (\\HasNoChildren) "/" "INBOX"');
+        send('* LIST (\\HasNoChildren) "/" "Sent"');
+        send('$tag OK LIST completed');
+      } else if (cmd == 'SELECT' || cmd == 'EXAMINE') {
+        send('* 1 EXISTS');
+        send('* 0 RECENT');
+        send('$tag OK [READ-WRITE] SELECT completed');
+      } else if (cmd == 'FETCH') {
+        final bytes = utf8.encode(_message);
+        send('* 1 FETCH (BODY[] {${bytes.length}}');
+        socket.add(bytes);
+        send(')');
+        send('$tag OK FETCH completed');
+      } else if (cmd == 'LOGOUT') {
+        send('$tag OK LOGOUT completed');
+        await socket.close();
+        return;
+      } else if (cmd == 'NOOP' || cmd == 'STARTTLS') {
+        send('$tag OK completed');
+      } else {
+        send('$tag BAD $cmd');
+      }
+    }
+  }
+
+  static Future<void> _pop(Socket socket, String user, String secret) async {
+    final reader = socket.cast<List<int>>().transform(utf8.decoder).transform(const LineSplitter());
+    void send(String line) => socket.write('$line\r\n');
+    send('+OK rpmail pop3');
+    var authed = false;
+    var gotUser = '';
+    await for (final line in reader) {
+      final cmd = line.split(' ').first.toUpperCase();
+      final arg = line.contains(' ') ? line.substring(line.indexOf(' ') + 1) : '';
+      if (cmd == 'USER') {
+        gotUser = arg;
+        send('+OK');
+      } else if (cmd == 'PASS') {
+        authed = gotUser == user && arg == secret;
+        send(authed ? '+OK' : '-ERR');
+      } else if (cmd == 'STAT') {
+        send('+OK 1 ${_message.length}');
+      } else if (cmd == 'RETR') {
+        send('+OK');
+        for (final row in _message.split('\r\n')) {
+          send(row);
+        }
+        send('.');
+      } else if (cmd == 'QUIT') {
+        send('+OK');
+        await socket.close();
+        return;
+      } else {
+        send('-ERR');
+      }
+    }
+  }
+
+  static Future<void> _smtp(Socket socket, String user, String secret, List<String> sent) async {
+    final reader = socket.cast<List<int>>().transform(utf8.decoder).transform(const LineSplitter());
+    void send(String line) => socket.write('$line\r\n');
+    send('220 rpmail smtp');
+    var authed = false;
+    var data = false;
+    final buf = StringBuffer();
+    await for (final line in reader) {
+      if (data) {
+        if (line == '.') {
+          data = false;
+          sent.add(buf.toString());
+          send('250 queued');
+        } else {
+          buf.writeln(line.startsWith('..') ? line.substring(1) : line);
+        }
+        continue;
+      }
+      final cmd = line.split(' ').first.toUpperCase();
+      if (cmd == 'EHLO' || cmd == 'HELO') {
+        send('250-rpmail');
+        send('250 AUTH PLAIN');
+      } else if (cmd == 'AUTH') {
+        final token = line.split(' ').last;
+        final raw = utf8.decode(base64Decode(token));
+        final parts = raw.split('\x00');
+        authed = parts.length >= 3 && parts[1] == user && parts[2] == secret;
+        send(authed ? '235 ok' : '535 denied');
+      } else if (cmd == 'MAIL' || cmd == 'RCPT') {
+        send(authed ? '250 ok' : '530 auth');
+      } else if (cmd == 'DATA') {
+        send('354 end');
+        data = true;
+      } else if (cmd == 'QUIT') {
+        send('221 bye');
+        await socket.close();
+        return;
+      } else {
+        send('250 ok');
+      }
+    }
+  }
+}
