+import 'dart:async';
+import 'dart:convert';
+import 'dart:io';
+import 'dart:typed_data';
+
+/// Host bridge for a pasted vortice whose body sets `hook` to [kContinuumMailHook].
+///
+/// Not a preinstall. Continuum shows the mail pane only after Vortex downloads
+/// a body that declares the hook. Mailbox secrets go in [MailSecretStore],
+/// beside the session file, and are not written into shewall or Spendable.
+const kContinuumMailHook = 'continuum.mail';
+
+const _roles = ['user', 'staff', 'moderator', 'admin'];
+const _walletKeys = {
+  'seed',
+  'seedHex',
+  'seed32',
+  'spendable',
+  'spendableNanos',
+  'pendingNanos',
+  'shewall',
+};
+
+bool vorticeDeclaresMailHook(String? source) {
+  if (source == null || source.isEmpty) return false;
+  try {
+    final decoded = jsonDecode(source);
+    return decoded is Map && decoded['hook'] == kContinuumMailHook;
+  } catch (_) {
+    return false;
+  }
+}
+
+bool canCreateCompanyMailbox(String role) {
+  final have = _roles.indexOf(role);
+  final need = _roles.indexOf('moderator');
+  return have >= need && need >= 0;
+}
+
+/// `plain`, `implicit` (993 / 995 / 465), or `starttls`.
+String mailTlsMode(String protocol, int port, bool tls) {
+  if (!tls) return 'plain';
+  if (protocol == 'imap' && port == 993) return 'implicit';
+  if (protocol == 'pop3' && port == 995) return 'implicit';
+  if (protocol == 'smtp' && port == 465) return 'implicit';
+  return 'starttls';
+}
+
+File mailSecretFileFor(File sessionStore) {
+  return File('${sessionStore.parent.path}${Platform.pathSeparator}rpmail-secrets.json');
+}
+
+class MailBridgeException implements Exception {
+  MailBridgeException(this.code);
+  final String code;
+
+  @override
+  String toString() => 'MailBridgeException($code)';
+}
+
+class MailLetter {
+  const MailLetter({
+    required this.messageId,
+    required this.subject,
+    required this.fromAddr,
+    required this.toAddrs,
+    required this.body,
+    this.folder = 'INBOX',
+  });
+
+  final String messageId;
+  final String subject;
+  final String fromAddr;
+  final List<String> toAddrs;
+  final String body;
+  final String folder;
+}
+
+class MailAccountSecret {
+  const MailAccountSecret({
+    required this.accountId,
+    required this.address,
+    required this.kind,
+    required this.role,
+    required this.receive,
+    required this.host,
+    required this.port,
+    required this.tls,
+    required this.user,
+    required this.secret,
+    required this.smtpHost,
+    required this.smtpPort,
+    required this.smtpTls,
+    required this.smtpUser,
+    required this.smtpSecret,
+  });
+
+  final String accountId;
+  final String address;
+  final String kind;
+  final String role;
+  final String receive;
+  final String host;
+  final int port;
+  final bool tls;
+  final String user;
+  final String secret;
+  final String smtpHost;
+  final int smtpPort;
+  final bool smtpTls;
+  final String smtpUser;
+  final String smtpSecret;
+
+  Map<String, Object> toJson() => {
+        'accountId': accountId,
+        'address': address,
+        'kind': kind,
+        'role': role,
+        'receive': receive,
+        'host': host,
+        'port': port,
+        'tls': tls,
+        'user': user,
+        'secret': secret,
+        'smtpHost': smtpHost,
+        'smtpPort': smtpPort,
+        'smtpTls': smtpTls,
+        'smtpUser': smtpUser,
+        'smtpSecret': smtpSecret,
+      };
+
+  factory MailAccountSecret.fromJson(Map<dynamic, dynamic> json) {
+    return MailAccountSecret(
+      accountId: json['accountId']?.toString() ?? '',
+      address: json['address']?.toString() ?? '',
+      kind: json['kind']?.toString() ?? 'personal',
+      role: json['role']?.toString() ?? 'user',
+      receive: json['receive']?.toString() ?? 'imap',
+      host: json['host']?.toString() ?? '',
+      port: (json['port'] as num?)?.toInt() ?? 993,
+      tls: json['tls'] == true,
+      user: json['user']?.toString() ?? '',
+      secret: json['secret']?.toString() ?? '',
+      smtpHost: json['smtpHost']?.toString() ?? '',
+      smtpPort: (json['smtpPort'] as num?)?.toInt() ?? 587,
+      smtpTls: json['smtpTls'] == true,
+      smtpUser: json['smtpUser']?.toString() ?? '',
+      smtpSecret: json['smtpSecret']?.toString() ?? '',
+    );
+  }
+}
+
+bool jsonHasWalletMaterial(Object? value) {
+  if (value is Map) {
+    for (final key in value.keys) {
+      if (_walletKeys.contains(key.toString())) return true;
+    }
+    for (final child in value.values) {
+      if (jsonHasWalletMaterial(child)) return true;
+    }
+  } else if (value is List) {
+    for (final child in value) {
+      if (jsonHasWalletMaterial(child)) return true;
+    }
+  }
+  return false;
+}
+
+/// Mail secrets are present only in [secretFileText]. Session plain text,
+/// shewall bytes, and the spendable figure stay clear of them.
+bool mailSecretsIsolated({
+  required String secret,
+  required String smtpSecret,
+  required String secretFileText,
+  required String sessionPlain,
+  required List<int> shewallBytes,
+  required num spendableBefore,
+  required num spendableAfter,
+}) {
+  if (secret.isEmpty || !secretFileText.contains(secret)) return false;
+  if (smtpSecret.isNotEmpty && !secretFileText.contains(smtpSecret)) return false;
+  if (sessionPlain.contains(secret)) return false;
+  if (smtpSecret.isNotEmpty && sessionPlain.contains(smtpSecret)) return false;
+  if (_containsAscii(shewallBytes, secret)) return false;
+  if (smtpSecret.isNotEmpty && _containsAscii(shewallBytes, smtpSecret)) return false;
+  if (spendableBefore != spendableAfter) return false;
+  try {
+    final decoded = jsonDecode(secretFileText);
+    if (jsonHasWalletMaterial(decoded)) return false;
+  } catch (_) {
+    return false;
+  }
+  return true;
+}
+
+bool _containsAscii(List<int> haystack, String needle) {
+  final want = utf8.encode(needle);
+  if (want.isEmpty || haystack.length < want.length) return false;
+  for (var i = 0; i + want.length <= haystack.length; i++) {
+    var match = true;
+    for (var j = 0; j < want.length; j++) {
+      if (haystack[i + j] != want[j]) {
+        match = false;
+        break;
+      }
+    }
+    if (match) return true;
+  }
+  return false;
+}
+
+class MailSecretStore {
+  MailSecretStore(this.file);
+
+  final File file;
+
+  void save(String vorticeId, MailAccountSecret account) {
+    if (account.kind == 'company' && !canCreateCompanyMailbox(account.role)) {
+      throw MailBridgeException('company_mailbox_requires_moderator');
+    }
+    final root = _read();
+    final accounts = Map<String, Object>.from((root['accounts'] as Map?) ?? {});
+    accounts['$vorticeId:${account.accountId}'] = account.toJson();
+    final next = <String, Object>{'v': 1, 'accounts': accounts};
+    if (jsonHasWalletMaterial(next)) {
+      throw MailBridgeException('refusing_wallet_material');
+    }
+    file.parent.createSync(recursive: true);
+    file.writeAsStringSync('${jsonEncode(next)}\n', flush: true);
+    if (!Platform.isWindows) {
+      try {
+        Process.runSync('chmod', ['600', file.path]);
+      } catch (_) {}
+    }
+  }
+
+  MailAccountSecret? read(String vorticeId, String accountId) {
+    final accounts = (_read()['accounts'] as Map?) ?? {};
+    final row = accounts['$vorticeId:$accountId'];
+    if (row is! Map) return null;
+    return MailAccountSecret.fromJson(row);
+  }
+
+  Map<String, Object?> _read() {
+    if (!file.existsSync()) {
+      return {'v': 1, 'accounts': <String, Object>{}};
+    }
+    final decoded = jsonDecode(file.readAsStringSync());
+    if (decoded is! Map) return {'v': 1, 'accounts': <String, Object>{}};
+    return Map<String, Object?>.from(decoded);
+  }
+}
+
+class MailBridge {
+  const MailBridge();
+
+  Future<List<String>> listFolders(MailAccountSecret account) async {
+    if (account.receive == 'pop3') return const ['INBOX'];
+    final conn = await _imapLogin(account);
+    try {
+      final reply = await _imapCommand(conn, 'LIST "" "*"');
+      final folders = <String>[];
+      for (final line in reply.lines) {
+        final name = _imapListName(line);
+        if (name.isNotEmpty && !folders.contains(name)) folders.add(name);
+      }
+      return folders.isEmpty ? const ['INBOX'] : folders;
+    } finally {
+      await _closeQuiet(conn);
+    }
+  }
+
+  Future<List<MailLetter>> fetchMessages(
+    MailAccountSecret account, {
+    String folder = 'INBOX',
+    int limit = 50,
+  }) async {
+    if (account.receive == 'pop3') {
+      return _fetchPop3(account, limit: limit);
+    }
+    final conn = await _imapLogin(account);
+    try {
+      final selected = await _imapCommand(conn, 'SELECT ${_imapQuote(folder)}');
+      var count = 0;
+      for (final line in selected.lines) {
+        final match = RegExp(r'^\* (\d+) EXISTS').firstMatch(line);
+        if (match != null) count = int.parse(match.group(1)!);
+      }
+      if (count <= 0) return const [];
+      final end = count;
+      final start = count > limit ? count - limit + 1 : 1;
+      final fetched = await _imapCommand(conn, 'FETCH $start:$end (BODY.PEEK[])');
+      return [
+        for (final literal in fetched.literals) parseRfc822(literal, folder: folder),
+      ];
+    } finally {
+      await _closeQuiet(conn);
+    }
+  }
+
+  Future<String> sendMessage(
+    MailAccountSecret account, {
+    required String to,
+    required String subject,
+    required String body,
+  }) async {
+    _rejectBreak(account.address);
+    _rejectBreak(to);
+    _rejectBreak(account.smtpUser);
+    _rejectBreak(account.smtpSecret);
+    final mode = mailTlsMode('smtp', account.smtpPort, account.smtpTls);
+    var conn = await _connect(account.smtpHost, account.smtpPort, mode);
+    try {
+      await _expectPrefix(conn, '220');
+      await conn.writeLine('EHLO rpmail');
+      await _readSmtpMultiline(conn);
+      if (mode == 'starttls') {
+        await conn.writeLine('STARTTLS');
+        await _expectPrefix(conn, '220');
+        conn = await conn.upgrade(account.smtpHost);
+        await conn.writeLine('EHLO rpmail');
+        await _readSmtpMultiline(conn);
+      }
+      final token = base64Encode(utf8.encode('\x00${account.smtpUser}\x00${account.smtpSecret}'));
+      await conn.writeLine('AUTH PLAIN $token');
+      await _expectPrefix(conn, '235');
+      await conn.writeLine('MAIL FROM:<${account.address}>');
+      await _expectPrefix(conn, '250');
+      await conn.writeLine('RCPT TO:<$to>');
+      await _expectPrefix(conn, '250');
+      await conn.writeLine('DATA');
+      await _expectPrefix(conn, '354');
+      final messageId = 'rpmail-${DateTime.now().microsecondsSinceEpoch}';
+      final raw = _rfc822(
+        from: account.address,
+        to: to,
+        subject: subject,
+        body: body,
+        messageId: messageId,
+      );
+      for (final line in raw.split('\r\n')) {
+        await conn.writeLine(line.startsWith('.') ? '.$line' : line);
+      }
+      await conn.writeLine('.');
+      await _expectPrefix(conn, '250');
+      await conn.writeLine('QUIT');
+      return messageId;
+    } on MailBridgeException {
+      rethrow;
+    } catch (_) {
+      throw MailBridgeException('smtp_failed');
+    } finally {
+      await _closeQuiet(conn);
+    }
+  }
+
+  Future<List<MailLetter>> _fetchPop3(MailAccountSecret account, {required int limit}) async {
+    _rejectBreak(account.user);
+    _rejectBreak(account.secret);
+    final mode = mailTlsMode('pop3', account.port, account.tls);
+    var conn = await _connect(account.host, account.port, mode);
+    try {
+      await _expectPrefix(conn, '+OK');
+      if (mode == 'starttls') {
+        await conn.writeLine('STLS');
+        await _expectPrefix(conn, '+OK');
+        conn = await conn.upgrade(account.host);
+      }
+      await conn.writeLine('USER ${account.user}');
+      await _expectPrefix(conn, '+OK');
+      await conn.writeLine('PASS ${account.secret}');
+      await _expectPrefix(conn, '+OK');
+      await conn.writeLine('STAT');
+      final stat = await conn.readLine();
+      if (!stat.startsWith('+OK')) throw MailBridgeException('pop_stat');
+      final count = int.tryParse(stat.split(' ').elementAt(1)) ?? 0;
+      if (count <= 0) return const [];
+      final start = count > limit ? count - limit + 1 : 1;
+      final letters = <MailLetter>[];
+      for (var i = start; i <= count; i++) {
+        await conn.writeLine('RETR $i');
+        await _expectPrefix(conn, '+OK');
+        final lines = await _readDotLines(conn);
+        letters.add(parseRfc822(lines.join('\r\n'), folder: 'INBOX'));
+      }
+      await conn.writeLine('QUIT');
+      return letters;
+    } on MailBridgeException {
+      rethrow;
+    } catch (_) {
+      throw MailBridgeException('pop_failed');
+    } finally {
+      await _closeQuiet(conn);
+    }
+  }
+
+  Future<MailConn> _imapLogin(MailAccountSecret account) async {
+    _rejectBreak(account.user);
+    _rejectBreak(account.secret);
+    final mode = mailTlsMode('imap', account.port, account.tls);
+    var conn = await _connect(account.host, account.port, mode);
+    try {
+      final greet = await conn.readLine();
+      if (!greet.startsWith('* OK') && !greet.startsWith('* PREAUTH')) {
+        throw MailBridgeException('imap_greeting');
+      }
+      if (mode == 'starttls') {
+        await _imapCommand(conn, 'STARTTLS');
+        conn = await conn.upgrade(account.host);
+      }
+      await _imapCommand(conn, 'LOGIN ${_imapQuote(account.user)} ${_imapQuote(account.secret)}');
+      return conn;
+    } catch (e) {
+      await _closeQuiet(conn);
+      if (e is MailBridgeException) rethrow;
+      throw MailBridgeException('imap_login_failed');
+    }
+  }
+}
+
+class ScriptedMailBridge extends MailBridge {
+  ScriptedMailBridge({
+    this.folders = const ['INBOX'],
+    this.letters = const [],
+  });
+
+  final List<String> folders;
+  final List<MailLetter> letters;
+  final List<MailLetter> sent = [];
+
+  @override
+  Future<List<String>> listFolders(MailAccountSecret account) async => folders;
+
+  @override
+  Future<List<MailLetter>> fetchMessages(
+    MailAccountSecret account, {
+    String folder = 'INBOX',
+    int limit = 50,
+  }) async {
+    return letters.where((letter) => letter.folder == folder).take(limit).toList();
+  }
+
+  @override
+  Future<String> sendMessage(
+    MailAccountSecret account, {
+    required String to,
+    required String subject,
+    required String body,
+  }) async {
+    const id = 'scripted-sent';
+    sent.add(MailLetter(
+      messageId: id,
+      subject: subject,
+      fromAddr: account.address,
+      toAddrs: [to],
+      body: body,
+      folder: 'Sent',
+    ));
+    return id;
+  }
+}
+
+class _ImapReply {
+  const _ImapReply(this.lines, this.literals);
+  final List<String> lines;
+  final List<String> literals;
+}
+
+int _imapSeq = 0;
+
+Future<_ImapReply> _imapCommand(MailConn conn, String command) async {
+  _imapSeq += 1;
+  final tag = 'A${_imapSeq.toString().padLeft(4, '0')}';
+  await conn.writeLine('$tag $command');
+  final lines = <String>[];
+  final literals = <String>[];
+  while (true) {
+    final line = await conn.readLine();
+    if (line.startsWith('$tag ')) {
+      final rest = line.substring(tag.length + 1);
+      if (!rest.startsWith('OK')) throw MailBridgeException('imap_failed');
+      return _ImapReply(lines, literals);
+    }
+    final literal = RegExp(r'\{(\d+)\}\s*$').firstMatch(line);
+    lines.add(line);
+    if (literal != null) {
+      final bytes = await conn.readBytes(int.parse(literal.group(1)!));
+      literals.add(utf8.decode(bytes, allowMalformed: true));
+    }
+  }
+}
+
+String _imapQuote(String value) {
+  final escaped = value.replaceAll(r'\', r'\\').replaceAll('"', r'\"');
+  return '"$escaped"';
+}
+
+String _imapListName(String line) {
+  if (!line.startsWith('* LIST')) return '';
+  final quoted = RegExp(r'"([^"]*)"\s*$').firstMatch(line);
+  if (quoted != null) return quoted.group(1) ?? '';
+  final parts = line.split(' ');
+  return parts.isEmpty ? '' : parts.last;
+}
+
+Future<MailConn> _connect(String host, int port, String mode) async {
+  try {
+    final socket = mode == 'implicit'
+        ? await SecureSocket.connect(host, port, timeout: const Duration(seconds: 20))
+        : await Socket.connect(host, port, timeout: const Duration(seconds: 20));
+    return MailConn(socket);
+  } catch (_) {
+    throw MailBridgeException('connect_failed');
+  }
+}
+
+Future<void> _expectPrefix(MailConn conn, String prefix) async {
+  final line = await conn.readLine();
+  if (!line.startsWith(prefix)) throw MailBridgeException('protocol');
+}
+
+Future<void> _readSmtpMultiline(MailConn conn) async {
+  while (true) {
+    final line = await conn.readLine();
+    if (RegExp(r'^\d{3} ').hasMatch(line)) return;
+    if (!RegExp(r'^\d{3}-').hasMatch(line)) throw MailBridgeException('smtp_ehlo');
+  }
+}
+
+Future<List<String>> _readDotLines(MailConn conn) async {
+  final lines = <String>[];
+  while (true) {
+    final line = await conn.readLine();
+    if (line == '.') break;
+    lines.add(line.startsWith('..') ? line.substring(1) : line);
+  }
+  return lines;
+}
+
+Future<void> _closeQuiet(MailConn conn) async {
+  try {
+    await conn.close();
+  } catch (_) {}
+}
+
+void _rejectBreak(String value) {
+  if (value.contains('\r') || value.contains('\n')) {
+    throw MailBridgeException('invalid_credential');
+  }
+}
+
+MailLetter parseRfc822(String raw, {String folder = 'INBOX'}) {
+  final splitAt = raw.indexOf('\r\n\r\n');
+  final alt = raw.indexOf('\n\n');
+  final cut = splitAt >= 0 ? splitAt : alt;
+  final header = cut >= 0 ? raw.substring(0, cut) : raw;
+  final body = cut >= 0 ? raw.substring(cut + (splitAt >= 0 ? 4 : 2)) : '';
+  String field(String name) {
+    final match = RegExp('^$name:\\s*(.*)\$', caseSensitive: false, multiLine: true).firstMatch(header);
+    return match?.group(1)?.trim() ?? '';
+  }
+
+  final messageId = field('Message-ID').replaceAll('<', '').replaceAll('>', '');
+  final to = field('To')
+      .split(',')
+      .map((part) => part.trim())
+      .where((part) => part.isNotEmpty)
+      .toList();
+  return MailLetter(
+    messageId: messageId.isEmpty ? 'mail-${raw.hashCode}' : messageId,
+    subject: field('Subject'),
+    fromAddr: field('From'),
+    toAddrs: to,
+    body: body.trim(),
+    folder: folder,
+  );
+}
+
+String _rfc822({
+  required String from,
+  required String to,
+  required String subject,
+  required String body,
+  required String messageId,
+}) {
+  return 'From: $from\r\nTo: $to\r\nSubject: $subject\r\nMessage-ID: <$messageId>\r\n\r\n$body';
+}
+
+class MailConn {
+  MailConn(this._socket) {
+    _sub = _socket.listen((data) {
+      _pending.addAll(data);
+      _signal();
+    }, onError: (_) {
+      _done = true;
+      _signal();
+    }, onDone: () {
+      _done = true;
+      _signal();
+    });
+  }
+
+  final Socket _socket;
+  final _pending = <int>[];
+  var _done = false;
+  var _closed = false;
+  late StreamSubscription<List<int>> _sub;
+  Completer<void>? _waiter;
+
+  void _signal() {
+    final waiter = _waiter;
+    if (waiter != null && !waiter.isCompleted) waiter.complete();
+  }
+
+  Future<void> _wait() async {
+    if (_pending.isNotEmpty || _done) return;
+    final waiter = Completer<void>();
+    _waiter = waiter;
+    if (_pending.isNotEmpty || _done) {
+      if (!waiter.isCompleted) waiter.complete();
+      return;
+    }
+    await waiter.future;
+  }
+
+  Future<String> readLine() async {
+    while (true) {
+      final cut = _crlf(_pending);
+      if (cut >= 0) {
+        final line = utf8.decode(_pending.sublist(0, cut), allowMalformed: true);
+        _pending.removeRange(0, cut + 2);
+        return line;
+      }
+      if (_pending.length > 1024 * 1024) throw MailBridgeException('line_too_long');
+      if (_done) throw MailBridgeException('closed');
+      await _wait();
+    }
+  }
+
+  Future<Uint8List> readBytes(int count) async {
+    while (_pending.length < count) {
+      if (_done) throw MailBridgeException('closed');
+      await _wait();
+    }
+    final out = Uint8List.fromList(_pending.sublist(0, count));
+    _pending.removeRange(0, count);
+    return out;
+  }
+
+  Future<void> writeLine(String line) async {
+    _socket.add(utf8.encode('$line\r\n'));
+    await _socket.flush();
+  }
+
+  Future<MailConn> upgrade(String host) async {
+    await _sub.cancel();
+    final secured = await SecureSocket.secure(_socket, host: host);
+    return MailConn(secured);
+  }
+
+  Future<void> close() async {
+    if (_closed) return;
+    _closed = true;
+    await _sub.cancel();
+    await _socket.close();
+  }
+}
+
+int _crlf(List<int> bytes) {
+  for (var i = 0; i + 1 < bytes.length; i++) {
+    if (bytes[i] == 13 && bytes[i + 1] == 10) return i;
+  }
+  return -1;
+}
