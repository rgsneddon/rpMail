+        TextField(
+          key: const Key('rpmail-address'),
+          controller: _address,
+          decoration: const InputDecoration(labelText: 'Address'),
+        ),
+        DropdownButtonFormField<String>(
+          key: const Key('rpmail-kind'),
+          initialValue: _kind,
+          decoration: const InputDecoration(labelText: 'Kind'),
+          items: const [
+            DropdownMenuItem(value: 'personal', child: Text('personal')),
+            DropdownMenuItem(value: 'company', child: Text('company')),
+          ],
+          onChanged: (value) => setState(() => _kind = value ?? 'personal'),
+        ),
+        DropdownButtonFormField<String>(
+          key: const Key('rpmail-role'),
+          initialValue: _role,
+          decoration: const InputDecoration(labelText: 'Role'),
+          items: const [
+            DropdownMenuItem(value: 'user', child: Text('user')),
+            DropdownMenuItem(value: 'staff', child: Text('staff')),
+            DropdownMenuItem(value: 'moderator', child: Text('moderator')),
+            DropdownMenuItem(value: 'admin', child: Text('admin')),
+          ],
+          onChanged: (value) => setState(() => _role = value ?? 'user'),
+        ),
+        DropdownButtonFormField<String>(
+          key: const Key('rpmail-receive'),
+          initialValue: _receive,
+          decoration: const InputDecoration(labelText: 'Receive'),
+          items: const [
+            DropdownMenuItem(value: 'imap', child: Text('imap')),
+            DropdownMenuItem(value: 'pop3', child: Text('pop3')),
+          ],
+          onChanged: (value) {
+            final next = value ?? 'imap';
+            setState(() {
+              _receive = next;
+              if (next == 'pop3' && _port.text == '993') _port.text = '995';
+              if (next == 'imap' && _port.text == '995') _port.text = '993';
+            });
+          },
+        ),
+        TextField(
+          key: const Key('rpmail-host'),
+          controller: _host,
+          decoration: const InputDecoration(labelText: 'Host'),
+        ),
+        TextField(
+          key: const Key('rpmail-port'),
+          controller: _port,
+          decoration: const InputDecoration(labelText: 'Port'),
+          keyboardType: TextInputType.number,
+        ),
+        SwitchListTile(
+          key: const Key('rpmail-tls'),
+          contentPadding: EdgeInsets.zero,
+          title: const Text('TLS'),
+          value: _tls,
+          onChanged: (value) => setState(() => _tls = value),
+        ),
+        TextField(
+          key: const Key('rpmail-user'),
+          controller: _user,
+          decoration: const InputDecoration(labelText: 'User'),
+        ),
+        TextField(
+          key: const Key('rpmail-secret'),
+          controller: _secret,
+          obscureText: true,
+          decoration: const InputDecoration(labelText: 'Mailbox secret'),
+        ),
+        TextField(
+          key: const Key('rpmail-smtp-host'),
+          controller: _smtpHost,
+          decoration: const InputDecoration(labelText: 'SMTP host'),
+        ),
+        TextField(
+          key: const Key('rpmail-smtp-port'),
+          controller: _smtpPort,
+          decoration: const InputDecoration(labelText: 'SMTP port'),
+          keyboardType: TextInputType.number,
+        ),
+        SwitchListTile(
+          key: const Key('rpmail-smtp-tls'),
+          contentPadding: EdgeInsets.zero,
+          title: const Text('SMTP TLS'),
+          value: _smtpTls,
+          onChanged: (value) => setState(() => _smtpTls = value),
+        ),
+        TextField(
+          key: const Key('rpmail-smtp-user'),
+          controller: _smtpUser,
+          decoration: const InputDecoration(labelText: 'SMTP user'),
+        ),
+        TextField(
+          key: const Key('rpmail-smtp-secret'),
+          controller: _smtpSecret,
+          obscureText: true,
+          decoration: const InputDecoration(labelText: 'SMTP secret'),
