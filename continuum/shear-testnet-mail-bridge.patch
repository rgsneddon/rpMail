+  final _sendTo = TextEditingController();
+  final _sendSubject = TextEditingController();
+  final _sendBody = TextEditingController();
+
+  String _kind = 'personal';
+  String _role = 'user';
+  String _receive = 'imap';
+  bool _tls = true;
+  bool _smtpTls = true;
+  String _status = '';
+  String _folder = 'INBOX';
+  List<String> _folders = const ['INBOX'];
+  List<MailLetter> _letters = const [];
+  MailLetter? _open;
+  var _busy = false;
+
+  @override
+  void dispose() {
+    for (final controller in [
+      _address,
+      _host,
+      _port,
+      _user,
+      _secret,
+      _smtpHost,
+      _smtpPort,
+      _smtpUser,
+      _smtpSecret,
+      _sendTo,
+      _sendSubject,
+      _sendBody,
+    ]) {
+      controller.dispose();
+    }
+    super.dispose();
+  }
+
+  MailAccountSecret? _draft() {
+    final address = _address.text.trim();
+    if (address.isEmpty || _host.text.trim().isEmpty) return null;
+    return MailAccountSecret(
+      accountId: address,
+      address: address,
+      kind: _kind,
+      role: _role,
+      receive: _receive,
+      host: _host.text.trim(),
+      port: int.tryParse(_port.text.trim()) ?? (_receive == 'pop3' ? 995 : 993),
+      tls: _tls,
+      user: _user.text.trim(),
+      secret: _secret.text,
+      smtpHost: _smtpHost.text.trim().isEmpty ? _host.text.trim() : _smtpHost.text.trim(),
+      smtpPort: int.tryParse(_smtpPort.text.trim()) ?? 587,
+      smtpTls: _smtpTls,
+      smtpUser: _smtpUser.text.trim().isEmpty ? _user.text.trim() : _smtpUser.text.trim(),
+      smtpSecret: _smtpSecret.text.isEmpty ? _secret.text : _smtpSecret.text,
+    );
+  }
+
+  void _save() {
+    if (_kind == 'company' && !canCreateCompanyMailbox(_role)) {
+      setState(() => _status = 'Company mailbox creation requires role moderator.');
+      return;
