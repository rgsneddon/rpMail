+
+void main() {
+  test('mail hook, tls mode, and company gate', () {
+    expect(vorticeDeclaresMailHook('{"id":"stake-pool-a","pane":"ok"}'), isFalse);
+    expect(vorticeDeclaresMailHook('{"hook":"continuum.mail","id":"rpmail-v1"}'), isTrue);
+    expect(vorticeDeclaresMailHook('not-json'), isFalse);
+    expect(canCreateCompanyMailbox('user'), isFalse);
+    expect(canCreateCompanyMailbox('staff'), isFalse);
+    expect(canCreateCompanyMailbox('moderator'), isTrue);
+    expect(canCreateCompanyMailbox('admin'), isTrue);
+    expect(mailTlsMode('imap', 993, true), 'implicit');
+    expect(mailTlsMode('imap', 143, true), 'starttls');
+    expect(mailTlsMode('imap', 143, false), 'plain');
+    expect(mailTlsMode('pop3', 995, true), 'implicit');
+    expect(mailTlsMode('pop3', 110, true), 'starttls');
+    expect(mailTlsMode('smtp', 465, true), 'implicit');
+    expect(mailTlsMode('smtp', 587, true), 'starttls');
+    expect(mailTlsMode('smtp', 25, false), 'plain');
+    final vortex = File('lib/main.dart').readAsStringSync();
+    final third = vortex.substring(
+      vortex.indexOf('Third-party vortice cannot mint SHE'),
+      vortex.indexOf('Widget _closure('),
+    );
+    expect(third.contains('Password'), isFalse);
+    expect(third.contains('vorticeDeclaresMailHook'), isTrue);
+    expect(vortex.contains("vortices = const [reserveVortice]"), isTrue);
+  });
+
