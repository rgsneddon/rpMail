+    const bridge = MailBridge();
+    expect(await bridge.listFolders(imap), ['INBOX', 'Sent']);
+    final letters = await bridge.fetchMessages(imap);
+    expect(letters.single.subject, 'Hello rpMail');
+    expect(letters.single.body, contains('A private note.'));
+    final pop = MailAccountSecret(
+      accountId: imap.accountId,
